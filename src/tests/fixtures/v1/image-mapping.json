{
  "schema_version": 1,
  "requirements": [
    "IMAGE-003",
    "IMAGE-008",
    "IMAGE-009",
    "IMAGE-012",
    "IMAGE-016"
  ],
  "canvas": {
    "width": 1024,
    "height": 512,
    "pixel_format": "RGBA8",
    "tile_order": ["front", "right", "back", "left"],
    "tile_width": 256
  },
  "normalized_atlas_cases": [
    {
      "id": "front-center",
      "input": {"cube": false, "region": "front", "depth_is_y": true, "position": [0.5, 0.5, 0.5], "normal": [0.0, -1.0, 0.0], "bounds_min": [0.0, 0.0, 0.0], "bounds_max": [1.0, 1.0, 1.0]},
      "expected": {"uv": [0.125, 0.5], "cube_side": false, "cube_edge": false}
    },
    {
      "id": "back-center",
      "input": {"cube": false, "region": "back", "depth_is_y": true, "position": [0.5, 0.5, 0.5], "normal": [0.0, 1.0, 0.0], "bounds_min": [0.0, 0.0, 0.0], "bounds_max": [1.0, 1.0, 1.0]},
      "expected": {"uv": [0.625, 0.5], "cube_side": false, "cube_edge": false}
    },
    {
      "id": "right-side-quarter-depth",
      "input": {"cube": true, "region": "side", "depth_is_y": true, "position": [0.75, 0.25, 0.5], "normal": [1.0, 0.0, 0.0], "bounds_min": [0.0, 0.0, 0.0], "bounds_max": [1.0, 1.0, 1.0]},
      "expected": {"uv": [0.3125, 0.5], "cube_side": true, "cube_edge": false}
    },
    {
      "id": "left-side-quarter-depth",
      "input": {"cube": true, "region": "side", "depth_is_y": true, "position": [0.25, 0.25, 0.5], "normal": [-1.0, 0.0, 0.0], "bounds_min": [0.0, 0.0, 0.0], "bounds_max": [1.0, 1.0, 1.0]},
      "expected": {"uv": [0.9375, 0.5], "cube_side": true, "cube_edge": false}
    },
    {
      "id": "cube-top-edge",
      "input": {"cube": true, "region": "front", "depth_is_y": true, "position": [0.5, 0.5, 0.5], "normal": [0.0, 0.0, 1.0], "bounds_min": [0.0, 0.0, 0.0], "bounds_max": [1.0, 1.0, 1.0]},
      "expected": {"uv": [0.5, 0.0], "cube_side": false, "cube_edge": true}
    }
  ],
  "canonical_projection_cases": [
    {
      "id": "cube-front",
      "kind": "cube",
      "input": {"position": [10.0, 0.0, 8.0], "normal": [0.0, -1.0, 0.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"face": "front", "uv": [0.14453125, 0.53125]}
    },
    {
      "id": "cube-right",
      "kind": "cube",
      "input": {"position": [0.0, -4.0, 0.0], "normal": [1.0, 0.0, 0.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"face": "right", "uv": [0.3671875, 0.5]}
    },
    {
      "id": "cube-back",
      "kind": "cube",
      "input": {"position": [10.0, 0.0, 0.0], "normal": [0.0, 1.0, 0.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"face": "back", "uv": [0.60546875, 0.5]}
    },
    {
      "id": "cube-left",
      "kind": "cube",
      "input": {"position": [0.0, -4.0, 0.0], "normal": [-1.0, 0.0, 0.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"face": "left", "uv": [0.8828125, 0.5]}
    },
    {
      "id": "round-front",
      "kind": "round",
      "input": {"region": "front", "depth_is_y": true, "position": [10.0, 0.0, 8.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"tile": 0, "uv": [0.14453125, 0.53125]}
    },
    {
      "id": "round-right",
      "kind": "round",
      "input": {"region": "side", "depth_is_y": true, "position": [10.0, -4.0, 0.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"tile": 1, "uv": [0.3671875, 0.5]}
    },
    {
      "id": "round-back",
      "kind": "round",
      "input": {"region": "back", "depth_is_y": true, "position": [10.0, 0.0, 0.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"tile": 2, "uv": [0.60546875, 0.5]}
    },
    {
      "id": "round-left",
      "kind": "round",
      "input": {"region": "side", "depth_is_y": true, "position": [-10.0, -4.0, 0.0], "center": [0.0, 0.0, 0.0], "pixels_per_unit": 2.0},
      "expected": {"tile": 3, "uv": [0.8828125, 0.5]}
    }
  ]
}

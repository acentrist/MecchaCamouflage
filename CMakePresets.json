{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/v2/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MECCHA_BUILD_TESTS": "ON",
        "MECCHA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "Secret-free Windows CI",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MECCHA_WITH_UE4SS": "OFF"
      }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows MSVC AddressSanitizer",
      "inherits": "ci-windows",
      "cacheVariables": {
        "MECCHA_ENABLE_MSVC_ADDRESS_SANITIZER": "ON"
      }
    },
    {
      "name": "windows-clang-ubsan",
      "displayName": "Windows clang-cl UndefinedBehaviorSanitizer",
      "inherits": "ci-windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "MECCHA_ENABLE_CLANG_CL_UBSAN": "ON"
      }
    },
    {
      "name": "windows-msvc-analysis",
      "displayName": "Windows MSVC native code analysis",
      "inherits": "ci-windows",
      "cacheVariables": {
        "MECCHA_BUILD_TESTS": "OFF",
        "MECCHA_ENABLE_MSVC_CODE_ANALYSIS": "ON"
      }
    },
    {
      "name": "full-windows",
      "displayName": "Trusted UE4SS and mod build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Game__Shipping__Win64",
        "MECCHA_WITH_UE4SS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "windows-msvc-asan",
      "configurePreset": "windows-msvc-asan"
    },
    {
      "name": "windows-clang-ubsan",
      "configurePreset": "windows-clang-ubsan"
    },
    {
      "name": "windows-msvc-analysis",
      "configurePreset": "windows-msvc-analysis",
      "targets": [
        "meccha_product_ui",
        "meccha_runtime_contracts",
        "meccha_launcher_core"
      ]
    },
    {
      "name": "full-windows",
      "configurePreset": "full-windows",
      "targets": [
        "UE4SS",
        "proxy",
        "meccha_mod",
        "meccha_contract_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-asan",
      "configurePreset": "windows-msvc-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-ubsan",
      "configurePreset": "windows-clang-ubsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
